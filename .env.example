# Jeton du tunnel Cloudflare (Zero Trust → Networks → Tunnels → votre tunnel → « Install connector »).
CLOUDFLARE_TUNNEL_TOKEN=

# Cloudflare Access (Zero Trust). Ces valeurs ne sont pas secrètes, mais OBLIGATOIRES :
# sans elles, /setup et les serveurs MCP refusent tout accès.
# - nom de l'équipe : Zero Trust -> Settings -> Custom Pages (ou Team name), ex. mon-equipe.cloudflareaccess.com
# - AUD : Zero Trust -> Access -> Applications -> votre application -> Overview -> Application Audience (AUD) Tag
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# Facultatif : récupérer les images construites par GitHub Actions au lieu de les construire sur le serveur.
# IMAGE_PREFIX=ghcr.io/flocom/mcp-seo-geo-stack

# Facultatif : intervalle (secondes) entre deux vérifications de mise à jour. 0 = désactivé.
# UPDATE_INTERVAL=300

# Facultatif : nombre maximal de sessions MCP ouvertes par serveur (gsc-bing, ga4). Chaque session
# lance un processus de ~150-200 Mo ; au-delà, la session inactive la plus ancienne est fermée.
# GATE_MAX_SESSIONS=6

# Facultatif : plafond mémoire de chaque conteneur MCP (gsc-bing, ga4).
# MCP_MEM_LIMIT=1536m
